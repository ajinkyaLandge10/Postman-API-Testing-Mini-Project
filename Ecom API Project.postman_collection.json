  "item": [
    {
      "name": "Login API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "pm.environment.set(\"token\", response.accessToken);\r",
              "console.log(pm.environment.get(\"token\"));\r",
              "\r",
              "//****************** Verify Status Code and Response Format ******************\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response is in JSON format\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Verify Access Token ******************\r",
              "pm.test(\"Access token is generated\", function () {\r",
              "    pm.expect(response.accessToken).to.exist;\r",
              "    pm.expect(response.accessToken).to.be.a(\"string\");\r",
              "    pm.expect(response.accessToken).to.not.be.empty;\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Verify Response Time ******************\r",
              "pm.test(\"Response time is less than 1000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"emilys\",\r\n    \"password\": \"emilyspass\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get User Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "//****************** Verify Status Code and Response Format ******************\r",
              "pm.test(\"Profile Fetched\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Response is in JSON format\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Validate Authenticated User ******************\r",
              "pm.test(\"Authenticated user details are correct\", function () {\r",
              "    pm.expect(response.id).to.eql(1);\r",
              "    pm.expect(response.username).to.eql(\"emilys\");\r",
              "    pm.expect(response.firstName).to.eql(\"Emily\");\r",
              "    pm.expect(response.lastName).to.eql(\"Johnson\");\r",
              "    pm.expect(response.role).to.eql(\"admin\");\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Validate Response Headers ******************\r",
              "pm.test(\"Content-Type is JSON\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
              "        .to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Validate Authentication ******************\r",
              "pm.test(\"Authentication is successful\", function () {\r",
              "    pm.expect(pm.response.code).to.eql(200);\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Verify Response Time ******************\r",
              "pm.test(\"Response time is less than 1000 ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/auth/me",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();\r",
              "pm.environment.set(\"product_id\", response.products[0].id);\r",
              "\r",
              "\r",
              "//  Verify Status Code and Response Format\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is in JSON format\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Products Exists\", function () {\r",
              "    pm.expect(response.products.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "\r",
              "//  Verify Products Array and Product Count\r",
              "pm.test(\"Products array is present\", function () {\r",
              "    pm.expect(response).to.have.property(\"products\");\r",
              "    pm.expect(response.products).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Products count matches limit\", function () {\r",
              "    pm.expect(response.products.length).to.eql(response.limit);\r",
              "});\r",
              "\r",
              "pm.test(\"Total products count is correct\", function () {\r",
              "    pm.expect(response.total).to.eql(194);\r",
              "});\r",
              "\r",
              "pm.test(\"Skip value is correct\", function () {\r",
              "    pm.expect(response.skip).to.eql(0);\r",
              "});\r",
              "\r",
              "pm.test(\"Limit value is correct\", function () {\r",
              "    pm.expect(response.limit).to.eql(30);\r",
              "});\r",
              "\r",
              "\r",
              "// Validate All Products\r",
              "\r",
              "pm.test(\"All products have valid mandatory fields\", function () {\r",
              "\r",
              "    response.products.forEach(function (product) {\r",
              "        pm.expect(product.id).to.be.a(\"number\");\r",
              "        pm.expect(product.title).to.be.a(\"string\");\r",
              "        pm.expect(product.category).to.be.a(\"string\");\r",
              "        pm.expect(product.price).to.be.a(\"number\");\r",
              "        pm.expect(product.rating).to.be.a(\"number\");\r",
              "        pm.expect(product.stock).to.be.a(\"number\");\r",
              "        pm.expect(product.price).to.be.above(0);\r",
              "        pm.expect(product.rating).to.be.within(0, 5);\r",
              "        pm.expect(product.stock).to.be.at.least(0);\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Single Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "//****************** Verify Status Code and Response Format ******************\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Verify Content-Type ******************\r",
              "pm.test(\"Content-Type is JSON\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"))\r",
              "        .to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Check Cache-Control Header ******************\r",
              "pm.test(\"Cache-Control header is present\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.exist;\r",
              "});\r",
              "\r",
              "\r",
              "//****************** Check Cache-Control Header ******************\r",
              "pm.test(\"Server header is present\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Server\")).to.exist;\r",
              "});\r",
              "\r",
              "//****************** Verify Product Details ******************\r",
              "pm.test(\"Product details are correct\", function () {\r",
              "    pm.expect(response.id).to.eql(1);\r",
              "    pm.expect(response.title).to.eql(\"Essence Mascara Lash Princess\");\r",
              "    pm.expect(response.category).to.eql(\"beauty\");\r",
              "    pm.expect(response.price).to.eql(9.99);\r",
              "    pm.expect(response.brand).to.eql(\"Essence\");\r",
              "    pm.expect(response.stock).to.eql(99);\r",
              "    pm.expect(response.availabilityStatus).to.eql(\"In Stock\");\r",
              "});\r",
              "\r",
              "//****************** Verify Mandatory Fields ******************\r",
              "\r",
              "pm.test(\"Mandatory fields are present\", function () {\r",
              "    pm.expect(response).to.have.property(\"id\");\r",
              "    pm.expect(response).to.have.property(\"title\");\r",
              "    pm.expect(response).to.have.property(\"description\");\r",
              "    pm.expect(response).to.have.property(\"category\");\r",
              "    pm.expect(response).to.have.property(\"price\");\r",
              "    pm.expect(response).to.have.property(\"rating\");\r",
              "    pm.expect(response).to.have.property(\"stock\");\r",
              "    pm.expect(response).to.have.property(\"brand\");\r",
              "});\r",
              "\r",
              "//****************** Verify Product Data Types and Values ******************\r",
              "\r",
              "pm.test(\"Product data is valid\", function () {\r",
              "    pm.expect(response.id).to.be.a(\"number\");\r",
              "    pm.expect(response.title).to.be.a(\"string\");\r",
              "    pm.expect(response.price).to.be.a(\"number\");\r",
              "    pm.expect(response.rating).to.be.a(\"number\");\r",
              "    pm.expect(response.stock).to.be.a(\"number\");\r",
              "    pm.expect(response.price).to.be.above(0);\r",
              "    pm.expect(response.rating).to.be.within(0, 5);\r",
              "    pm.expect(response.stock).to.be.at.least(0);\r",
              "});\r",
              "\r",
              "//****************** Verify Response Time ******************\r",
              "\r",
              "pm.test(\"Response time is less than 200ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/products/{{product_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "products",
            "{{product_id}}"
          ]
        }
      },
      "response": []
    }
  ]
